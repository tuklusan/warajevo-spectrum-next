<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Warajevo Next</Product>
    <Company>SANYALnet Labs</Company>
    <Authors>Supratim Sanyal (port); original Warajevo by Zeljko Juric and Samir Ribic</Authors>
    <Copyright>Copyright (c) 2026 Supratim Sanyal (port); original Warajevo (c) Zeljko Juric and Samir Ribic (GPL)</Copyright>
    <Description>Warajevo Next - a modern C#/.NET 10/Avalonia reimplementation of the classic ZX Spectrum 48K/128K emulator originally by Zeljko Juric and Samir Ribic (Warajevo 2.50, GPL).</Description>
  </PropertyGroup>
</Project>
